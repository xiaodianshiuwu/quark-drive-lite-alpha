    "test:rust": "node scripts/rust.js test",
    "verify:native": "node scripts/native-smoke.js",
    "test:legacy": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3"
  }
}
