{
  "name": "quark-mini",
  "version": "0.3.0-alpha.1",
  "private": true,
  "description": "夸克网盘极简桌面客户端 — 仅保留文件浏览、搜索、新建、移动、复制、重命名、批量删除、上传、下载与传输任务管理",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "start": "node scripts/tauri.js dev",
    "build": "node scripts/tauri.js build",
    "check": "node scripts/rust.js check",
